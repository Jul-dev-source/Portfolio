---
import Icon from './Icon.astro';
import Maybe from './Maybe.astro';
import { links, navTargets } from '../lib/links';
const { site } = Astro.props;
---
<header class="header">
  <a class="brand" href="#top">{site.name}</a>
  <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-nav" aria-label="Menu">
    <span></span><span></span>
  </button>
  <nav id="site-nav" class="nav" aria-label="Main">
    <ul>
      {site.nav.map((item, i) => (
        <li class={i === 3 ? 'nav__split' : ''}><a href={navTargets[item]}>{item}</a></li>
      ))}
    </ul>
    <Maybe class="pill" href={links.resume}><Icon name="download" />{site.resume}</Maybe>
  </nav>
</header>

<style>
  .header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-5);
    padding: var(--space-5);
  }
  .brand, .nav a:not(.pill) { font-size: var(--text-sm); letter-spacing: var(--tracking-tight); transition: color var(--transition); }
  .brand { display: inline-flex; align-items: center; min-height: var(--control-sm); }
  .brand:hover, .nav a:not(.pill):hover { color: var(--color-accent); }
  .nav, .nav ul { display: flex; align-items: center; gap: var(--space-4); }
  .nav ul { gap: var(--space-4); }
  .nav li a { display: inline-flex; align-items: center; min-height: var(--control-sm); }
  .nav__split { display: flex; align-items: center; }
  .nav__split::before {
    content: '';
    width: 1px;
    height: var(--space-4);
    margin-right: var(--space-4);
    background: var(--color-border);
  }
  .pill :global(svg) { width: var(--space-4); height: var(--space-4); }
  .menu-toggle { display: none; }

  @media (max-width: 639px) {
    .header { position: relative; padding: var(--space-3) var(--space-4); }
    .menu-toggle {
      display: grid;
      gap: var(--space-2);
      align-content: center;
      justify-items: end;
      width: var(--control-sm);
      height: var(--control-sm);
      margin-right: calc(var(--space-1) * -1);
      padding: 0;
      border: 0;
      background: none;
      color: inherit;
      cursor: pointer;
    }
    .menu-toggle span { display: block; width: var(--space-5); height: 2px; background: currentColor; transition: transform var(--transition); }
    .menu-toggle[aria-expanded='true'] span:first-child { transform: translateY(5px) rotate(45deg); }
    .menu-toggle[aria-expanded='true'] span:last-child { transform: translateY(-5px) rotate(-45deg); }
    .nav {
      display: none;
      position: absolute;
      inset: 100% var(--space-4) auto;
      z-index: 5;
      flex-direction: column;
      align-items: stretch;
      gap: var(--space-3);
      padding: var(--space-4);
      background: var(--color-surface);
      border-radius: var(--radius-md);
    }
    .nav.is-open { display: flex; }
    .nav ul { flex-direction: column; align-items: stretch; gap: 0; }
    .nav li a { font-size: var(--text-md); }
    .nav__split::before { display: none; }
    .pill { background: var(--color-bg); justify-content: center; }
  }
</style>

<script>
  const toggle = document.querySelector('.menu-toggle');
  const nav = document.getElementById('site-nav');
  const set = (open) => {
    toggle.setAttribute('aria-expanded', String(open));
    nav.classList.toggle('is-open', open);
  };
  toggle.addEventListener('click', () => set(toggle.getAttribute('aria-expanded') !== 'true'));
  nav.addEventListener('click', (e) => { if (e.target.closest('a')) set(false); });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') set(false); });
</script>
